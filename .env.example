# ─────────────────────────────────────────────────────────────────────────────
# CommerceJet — environment template
# Copy this file to `.env` and fill in your own values. NEVER commit a real .env
# (it is gitignored) and NEVER include it in a template/ZIP you distribute.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend (Vite) — safe to ship in the client bundle ──────────────────────
# Your Supabase project URL and PUBLIC anon key (Project Settings → API).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Display-only estimated tax rate as a fraction (e.g. 0.07 = 7%). Default 0 = no
# tax shown. Keep this in sync with the backend TAX_RATE. When Stripe Tax is
# enabled, set this to 0 (Stripe computes the real tax at checkout).
VITE_TAX_RATE=0

# Optional: version string shown on the Settings page.
VITE_APP_VERSION=1.0.0

# ─────────────────────────────────────────────────────────────────────────────
# Edge Function secrets — DO NOT put these in this file or the client bundle.
# Set them in the Supabase dashboard (Edge Functions → Secrets) or via
# `supabase secrets set`. Listed here only for reference.
#
#   STRIPE_SECRET_KEY        Stripe secret key (sk_test_… / sk_live_…)
#   STRIPE_WEBHOOK_SECRET    Signing secret of your Stripe webhook endpoint
#   ALLOWED_ORIGINS          Comma-separated production origins, e.g.
#                            https://yourstore.com,https://www.yourstore.com
#   ALLOW_VERCEL_PREVIEWS    "true" in dev/preview, "false" in production
#   VERCEL_PREVIEW_PREFIX    Required when ALLOW_VERCEL_PREVIEWS=true: your
#                            project's preview hostname prefix (e.g. "my-store"
#                            to allow my-store-git-branch-acme.vercel.app).
#                            Without it previews are rejected — ".vercel.app"
#                            alone is not a trust boundary, since anyone can
#                            deploy a free project on that domain.
#   TAX_RATE                 Flat tax fraction used when Stripe Tax is OFF (e.g. 0.07). Default 0
#   STRIPE_TAX_ENABLED       "true" to use Stripe Tax (real per-state US sales tax)
#   RESEND_API_KEY           (optional) transactional email via Resend
#   RESEND_FROM_EMAIL        (optional) sender, e.g. "Your Store <support@yourstore.com>"
#
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / SUPABASE_ANON_KEY are injected
# automatically by the Supabase Edge runtime — you do not set them by hand.
# ─────────────────────────────────────────────────────────────────────────────
